        }
      }
    },
    "That file holds the passwords in plain text. Delete it once the other browser has taken them in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのファイルにはパスワードが平文で入っています。他のブラウザに読み込ませたら削除してください。"
          }
        }
      }
    },
    "That folder does not contain manifest.json." : {
      "comment" : "Error message when the folder chosen does not contain a manifest.json file.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのフォルダには manifest.json がありません。"
          }
        }
      }
    },
    "The %lld pinned tabs will stay as they are." : {
      "comment" : "Text that explains which pinned tabs will not be closed. The argument is the number of pinned tabs.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めの %lld 枚は、そのままにしておきます。"
          }
        }
      }
    },
    "The address may be misspelled, or the site may no longer exist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address may be misspelled, or the site may no longer exist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスの綴りが違うか、そのサイトがもう無いのかもしれません。"
          }
        }
      }
    },
    "The bookmark bar will be emptied. This cannot be undone." : {
      "comment" : "A message displayed in a confirmation dialog.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bookmark bar will be emptied. This cannot be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブックマークバーが空になり、元に戻すことはできません。"
          }
        }
      }
    },
    "The certificate could not be verified. A server that is merely misconfigured looks exactly like one that someone has stepped in front of, so continue only if you know why this certificate is untrusted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate could not be verified. A server that is merely misconfigured looks exactly like one that someone has stepped in front of, so continue only if you know why this certificate is untrusted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書を確かめられませんでした。ただ設定を誤っているだけのサーバと、間に誰かが割り込んでいるサーバは、外からは全く同じに見えます。この証明書が信用されない理由に心当たりがある時だけ先へ進んでください。"
          }
        }
      }
    },
    "The certificate is not trusted" : {
      "comment" : "The heading in the site information popover when the user continued past a certificate error.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate is not trusted"
