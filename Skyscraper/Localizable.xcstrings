    "Tab addresses are saved on quit. Turning this off also disables recovery after a crash." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab addresses are saved on quit. Turning this off also disables recovery after a crash."
