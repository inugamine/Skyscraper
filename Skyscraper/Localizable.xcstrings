        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスの綴りが違うか、そのサイトがもう無いのかもしれません。"
          }
        }
      }
    },
    "The certificate could not be verified. Skyscraper offers no way past this, because there is no safe way to tell a misconfigured site from an intercepted one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate could not be verified. Skyscraper offers no way past this, because there is no safe way to tell a misconfigured site from an intercepted one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書を確かめられませんでした。設定を誤っているだけのサイトと、通信を覗かれている場合とを安全に見分ける方法は無いので、Skyscraper はここを迂回する道を用意していません。"
          }
        }
      }
    },
    "The file may have been moved or deleted." : {
