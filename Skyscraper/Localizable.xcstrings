    "SKYSCRAPER" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "Skyscraper asks you before any site is told where you are, and remembers your answer for that site. Turning this off refuses every site without asking. Your location never leaves your Mac unless you allow it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper asks you before any site is told where you are, and remembers your answer for that site. Turning this off refuses every site without asking. Your location never leaves your Mac unless you allow it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのサイトに現在地を渡す時も、Skyscraper は先に確認し、そのサイトについての答えを記憶します。オフにすると、確認せずにすべてのサイトを拒否します。許可しない限り、現在地がこの Mac から出ることはありません。"
          }
        }
      }
    },
    "Skyscraper cannot open an address of this kind." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper cannot open an address of this kind."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper はこの種類のアドレスを開けません。"
          }
        }
      }
    },
    "Skyscraper does not have the certificate for this connection." : {
      "comment" : "Shown in the certificate dialog when no certificate was captured.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper does not have the certificate for this connection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続の証明書は手元にありません。"
          }
        }
      }
    },
    "Skyscraper is built on the work of others. The licenses below are reproduced in full." : {
      "comment" : "A description of the licenses displayed in the acknowledgements.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper is built on the work of others. The licenses below are reproduced in full."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyscraper は、他の方々の成果の上に成り立っています。以下にライセンスの全文を掲載します。"
          }
        }
      }
    },
    "Skyscraper is your default browser." : {
      "comment" : "A message that displays when the app is set as the default browser.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
